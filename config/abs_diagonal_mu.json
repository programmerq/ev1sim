{
  "//": "Config wrapper for the diagonal-µ ABS scenario.  Loads the",
  "//1": "alternating-stripe level (level/flat_diagonal_mu.json) where the",
  "//2": "left and right lanes have alternating asphalt/ice stripes that",
  "//3": "cycle every wheelbase, putting one diagonal pair on each surface",
  "//4": "at any instant.",

  "vehicle_model": "ev1",
  "terrain": {
    "type": "level",
    "level_file": "level/flat_diagonal_mu.json"
  },
  "simulation": {
    "step_size_s": 0.002,
    "render_fps": 60,
    "realtime": true,
    "headless": true
  },
  "telemetry": { "log_to_file": false, "show_hud": false },
  "external_sim": { "enabled": true },
  "vehicle_dynamics": { "start_propulsion_enabled": true },
  "scenario": { "path": "config/scenarios/abs_diagonal_mu.json" }
}
